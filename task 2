"""Task 2: Write, append, and read data from a file."""

filename = "output.txt"

try:
    user_data = input("Enter a number or some text: ")

    # Write mode creates the file or replaces its previous content.
    with open(filename, "w", encoding="utf-8") as file:
        file.write(user_data + "\n")

    # Append mode adds new content to the end of the file.
    additional_data = input("Enter additional data to append: ")
    with open(filename, "a", encoding="utf-8") as file:
        file.write(additional_data + "\n")

    # Read and display the final content.
    print(f"\nFinal contents of {filename}:")
    with open(filename, "r", encoding="utf-8") as file:
        print(file.read(), end="")

except OSError as error:
    print(f"File operation failed: {error}")
